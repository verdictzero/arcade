[physics]

3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=0
lights_and_shadows/directional_shadow/16_bits=false
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=0
lights_and_shadows/positional_shadow/atlas_16_bits=false
reflections/sky_reflections/roughness_layers=4
anti_aliasing/screen_space_roughness_limiter/enabled=false
textures/vram_compression/import_etc2_astc=true
scaling_3d/scale=1.0
scaling_3d/fsr_sharpness=0.0
environment/glow/upscale_mode=0

[shader_globals]

tod_water_tint={
"type": "color",
"value": Color(1, 1, 1, 1)
}
tod_haze_tint={
"type": "color",
"value": Color(1, 1, 1, 1)
}
tod_art_tint={
"type": "color",
"value": Color(1, 1, 1, 1)
}
tod_daylight={
"type": "float",
"value": 1.0
}
tod_env_blend={
"type": "float",
"value": 0.0
}
tod_sun_dir={
"type": "vec3",
"value": Vector3(0, 0.8, 0.6)
}
tod_sun_color={
"type": "color",
"value": Color(1, 1, 1, 1)
}
tod_sky_color={
"type": "color",
"value": Color(0.156, 0.1635, 0.174, 1)
}
tod_ground_color={
"type": "color",
"value": Color(0.114, 0.1065, 0.096, 1)
}
sea_surface_y={
"type": "float",
"value": -45.0
}
sea_surface_color={
"type": "color",
"value": Color(0.34, 0.34, 0.34, 1)
}
sea_interior_color={
"type": "color",
"value": Color(0.089, 0.089, 0.089, 1)
}
veg_burn={
"type": "float",
"value": 0.0
}
veg_burn_front={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
veg_stump={
"type": "float",
"value": 0.0
}
golf_wall_axis={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
golf_wall_shape={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
golf_wall_fx={
"type": "vec4",
"value": Vector4(0, 0, 8, 0)
}
golf_wall_tint={
"type": "vec4",
"value": Vector4(1, 0.86, 0.71, 1)
}
golf_wall_film={
"type": "vec4",
"value": Vector4(0.16, 480, 12, 0)
}
golf_wall_player={
